# Moonshot / Kimi API Key
MOONSHOT_API_KEY="sk-xxxx"
# Base URL: China endpoint
MOONSHOT_API_BASE="https://api.moonshot.cn/v1"
# If you use global endpoint, switch to:
# MOONSHOT_API_BASE="https://api.moonshot.ai/v1"
# Model name (Moonshot docs示例常见如 kimi-k2-turbo；你也可以替换成你控制台可用的模型名)
KIMI_MODEL="moonshot-v1-32k"